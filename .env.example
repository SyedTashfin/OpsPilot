# OpsPilot application
NODE_ENV=development
API_PORT=4000
WEB_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgres://opspilot:opspilot@localhost:5432/opspilot

# Local AI defaults
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional Gemini provider, disabled when empty
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Langfuse self-hosted development instance
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
OTEL_SERVICE_NAME=opspilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3001/api/public/otel
