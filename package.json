{
  "name": "opspilot",
  "version": "1.0.0",
  "private": true,
  "description": "OpsPilot is a local-first AI operations copilot MVP for incident investigation over synthetic BeautyCorp logs and runbooks.",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run scripts/**/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "docker:config": "docker compose --env-file .env.example -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.langfuse.yml config",
    "docker:build": "docker compose --env-file .env.example -f infra/compose/docker-compose.yml build",
    "docker:up": "docker compose --env-file .env.example -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.langfuse.yml up -d",
    "docker:down": "docker compose --env-file .env.example -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.langfuse.yml down",
    "rag:ingest": "tsx scripts/rag/ingest-runbooks.ts",
    "rag:search": "tsx scripts/rag/search-runbooks.ts",
    "demo:investigation": "tsx scripts/demo/run-investigation.ts",
    "docs:check": "tsx scripts/ci/check-docs.ts",
    "security:scan": "tsx scripts/ci/secret-scan.ts",
    "test:db": "OPSPILOT_RUN_DB_TESTS=true vitest run packages/database/src/migrations.test.ts --reporter=verbose --no-file-parallelism && OPSPILOT_RUN_DB_TESTS=true vitest run apps/api/src/modules/investigations/investigation.integration.test.ts --reporter=verbose --no-file-parallelism",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@opspilot/database": "workspace:^",
    "@opspilot/llm": "workspace:^",
    "@opspilot/rag": "workspace:^",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.54.2"
  }
}
